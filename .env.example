# Copy to .env for local development. Never commit .env.
# On Vercel, add these under Project Settings, Environment Variables (Production and Preview).

# Required. Create at https://resend.com/api-keys (a key with "Sending access" is enough).
RESEND_API_KEY=

# Where messages are delivered. Defaults to ibrahimowolabiayomide@gmail.com when unset.
CONTACT_TO_EMAIL=ibrahimowolabiayomide@gmail.com

# The sender. It must be an address on a domain verified in Resend, for example
#   Neuroforge Portfolio <contact@yourdomain.com>
# Until you verify a domain, leave this unset: the default onboarding@resend.dev sender only
# delivers to the email address of your own Resend account.
CONTACT_FROM_EMAIL=

# Origins allowed to post to the form (comma separated, no trailing slash).
# The request's own host is always accepted, so preview deployments keep working.
SITE_ORIGIN=https://neuroforge-portfolio.vercel.app
